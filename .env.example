# ── Banco de dados (usado pelo docker compose) ──────────────────────
POSTGRES_USER=painel
POSTGRES_PASSWORD=painel
POSTGRES_DB=painel
# Porta do Postgres exposta no host (para acessar o banco de fora)
POSTGRES_PORT=5432

# ── Aplicação ────────────────────────────────────────────────────────
# Porta em que a aplicação fica acessível no host
APP_PORT=3000
# Credenciais de login da aplicação
APP_USER=admin
APP_PASSWORD=admin123
# Segredo da sessão: troque por um valor aleatório com PELO MENOS 32 caracteres
SESSION_SECRET=troque-por-um-segredo-aleatorio-com-32-caracteres-ou-mais

# ── Desenvolvimento local (npm run dev, fora do Docker) ─────────────
# Mesmos nomes das envs injetadas pelo Neon na Vercel; localmente os dois
# apontam para o Postgres do compose exposto no host
POSTGRES_PRISMA_URL=postgresql://painel:painel@localhost:5432/painel
POSTGRES_URL_NON_POOLING=postgresql://painel:painel@localhost:5432/painel
