generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled (runtime) e direta (migrations). Na Vercel, o Neon injeta esses
  // nomes; localmente os dois apontam para o mesmo Postgres do Docker.
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Section {
  NACIONAL
  INTERNACIONAL
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
}

enum WorkModel {
  REMOTO
  HIBRIDO
  PRESENCIAL
}

enum RejectionReason {
  SEM_RETORNO
  PERFIL_NAO_ADERENTE
  EXPERIENCIA
  PRETENSAO_SALARIAL
  IDIOMA
  TESTE_TECNICO
  ENTREVISTA
  VAGA_ENCERRADA
  VISTO_LOCALIZACAO
  OUTRO
}

enum EventType {
  CREATED
  STAGE_CHANGED
  REJECTED
  RESTORED
  NOTE
  EDITED
  ARCHIVED
  UNARCHIVED
}

enum SwotQuadrant {
  FORCA
  FRAQUEZA
  OPORTUNIDADE
  AMEACA
}

model Stage {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  order       Int
  color       String
  isRejection Boolean @default(false)

  applications Application[]
  rejectedFrom Application[] @relation("RejectedFromStage")

  @@map("stages")
}

model Application {
  id       String  @id @default(cuid())
  section  Section
  stage    Stage   @relation(fields: [stageId], references: [id])
  stageId  String
  position Float   @default(0)

  company      String
  roleTitle    String
  jobUrl       String?
  platform     String?
  locationCity String?
  workModel    WorkModel?
  countryCode  String?
  salary       String?
  priority     Priority   @default(MEDIA)
  appliedAt    DateTime?
  notes        String?

  rejectionReason     RejectionReason?
  rejectionNote       String?
  rejectedAt          DateTime?
  rejectedFromStage   Stage?           @relation("RejectedFromStage", fields: [rejectedFromStageId], references: [id])
  rejectedFromStageId String?

  jobDescription String?
  applicationUrl String?
  nextActionNote String?
  nextActionAt   DateTime?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  events    ApplicationEvent[]
  swotItems SwotItem[]

  @@index([section, stageId])
  @@map("applications")
}

model SwotItem {
  id            String       @id @default(cuid())
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String? // null = SWOT geral de carreira
  quadrant      SwotQuadrant
  text          String
  createdAt     DateTime     @default(now())

  @@index([applicationId, quadrant])
  @@map("swot_items")
}

model Document {
  id        String   @id @default(cuid())
  name      String // rótulo dado pelo usuário ("CV PT", "CV EN"...)
  fileName  String // nome original do arquivo
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("documents")
}

model TextDoc {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("text_docs")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

model ApplicationEvent {
  id            String      @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  type          EventType
  fromStageId   String?
  toStageId     String?
  data          Json?
  createdAt     DateTime    @default(now())

  @@index([applicationId, createdAt])
  @@index([createdAt])
  @@map("application_events")
}
